node_modules/

# Scratch output from the tools. Every one of these is regenerated by a command
# in package.json; none of it is input.
/tmp/
*.dcd
*.rst7
*.pdb.out
leap.log
tleap.log

.DS_Store

# Review probes are scratch, not gates - docs/REVIEW.md says which five were
# promoted. Keeping these out stops a probe nothing runs from rotting into a
# claim nobody checks.
tools/gpu/review-*.mjs
